@inject GameState State
@using System.Drawing

<nav>
    @for (byte i = 0; i < 7; i++)
    {
        var col = i;
        <span title="Click to play a piece" @onclick="() => PlayPiece(col)">🔽</span>
    }
</nav>

<article>
    @winnerMessage  <button style="@ResetStyle" @onclick="ResetGame">Reset the game</button>
    <br />
    <span class="alert-danger">@errorMessage</span>
    <span class="alert-info">@CurrentTurn</span>
</article>

<div style="--board-bg: @ColorTranslator.ToHtml(BoardColor); --player1: @ColorTranslator.ToHtml(Player1Color); --player2: @ColorTranslator.ToHtml(Player2Color);">
   <div class="board">
      @for (var i = 0; i < 42; i++)
      {
         <span class="container">
            <span></span>
         </span>
      }
   </div>
   @for (var i = 0; i < 42; i++)
   {
      <span class="@pieces[i]"></span>
   }
</div>

<div>
    <div>
        <label>Board Color: </label>
        @foreach (var (name, color) in BoardColors)
        {
            var c = color;
            <button style="background-color: @ColorTranslator.ToHtml(c); width: 30px; height: 30px;"
                    @onclick="() => BoardColor = c"></button>
        }
    </div>
    <div>
        <label>Player 1 Color: </label>
        @foreach (var (name, color) in Player1Colors)
        {
            var c = color;
            <button style="background-color: @ColorTranslator.ToHtml(c); width: 30px; height: 30px;"
                    @onclick="() => Player1Color = c"></button>
        }
    </div>
    <div>
        <label>Player 2 Color: </label>
        @foreach (var (name, color) in Player2Colors)
        {
            var c = color;
            <button style="background-color: @ColorTranslator.ToHtml(c); width: 30px; height: 30px;"
                    @onclick="() => Player2Color = c"></button>
        }
    </div>
</div>

@code {
   public Color BoardColor { get; set; } = Color.Black;
   public Color Player1Color { get; set; } = Color.Green;
   public Color Player2Color { get; set; } = Color.Purple;

   private static readonly List<(string Name, Color Color)> BoardColors = new()
   {
       ("Black",      Color.Black),
       ("Navy",       Color.FromArgb(0, 0, 128)),
       ("Dark Green", Color.FromArgb(0, 100, 0)),
       ("Dark Gray",  Color.FromArgb(64, 64, 64)),
   };

   private static readonly List<(string Name, Color Color)> Player1Colors = new()
   {
       ("Red",    Color.Red),
       ("Yellow", Color.Yellow),
       ("Light Purple", Color.FromArgb(180, 130, 255)),
       ("Orange", Color.Orange),
   };

   private static readonly List<(string Name, Color Color)> Player2Colors = new()
   {
       ("Pink",       Color.HotPink),
       ("Teal",       Color.Teal),
       ("Lime",       Color.FromArgb(0, 255, 128)),
       ("Light Blue", Color.FromArgb(0, 200, 255)),
   };

   private string[] pieces = new string[42];
   private string winnerMessage = string.Empty;
   private string errorMessage = string.Empty;

   private string CurrentTurn => (winnerMessage == string.Empty) ? $"Player {State.PlayerTurn}'s Turn" : "";
   private string ResetStyle => (winnerMessage == string.Empty) ? "display: none;" : "";

   private void PlayPiece(byte col)
   {
      errorMessage = string.Empty;
      try
      {
         var player = State.PlayerTurn;
         var turn = State.CurrentTurn;
         var landingRow = State.PlayPiece(col);
         pieces[turn] = $"player{player} col{col} drop{landingRow}";
      }
      catch (ArgumentException ex)
      {
         errorMessage = ex.Message;
      }

      winnerMessage = State.CheckForWin() switch
      {
         GameState.WinState.Player1_Wins => "Player 1 Wins!",
         GameState.WinState.Player2_Wins => "Player 2 Wins!",
         GameState.WinState.Tie => "It's a tie!",
         _ => ""
      };
   }

   protected override void OnInitialized()
   {
      State.ResetBoard();
   }

   void ResetGame()
   {
      State.ResetBoard();
      winnerMessage = string.Empty;
      errorMessage = string.Empty;
      pieces = new string[42];
   }
}



